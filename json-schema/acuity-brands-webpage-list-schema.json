{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://schema.api-evangelist.com/acuity-brands/acuity-brands-webpage-list-schema.json",
  "title": "WebpageList",
  "description": "Paginated list of web pages",
